# Labezra POS — Environment Configuration
# Copy this file to .env and fill in the values

# Django
DJANGO_SECRET_KEY=your-secret-key-here-generate-a-strong-one
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database (default: SQLite, change for PostgreSQL in production)
# DATABASE_URL=postgres://user:pass@localhost:5432/labezra

# Email (for password reset)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@labezra.com
